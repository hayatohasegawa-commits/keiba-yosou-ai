# Streamlit シークレット設定ファイルテンプレ
#
# ローカル開発: このファイルを .streamlit/secrets.toml にコピーして編集
# Streamlit Community Cloud: アプリの Settings → Secrets に貼り付け

# パスワードゲート (空文字なら認証なし)
app_password = "好きなパスワードをここに"

# チャットbot機能のON/OFF (公開時は true 推奨：API課金リスク回避)
disable_chat = true

# チャットON時のみ必要: Anthropic API key
# ANTHROPIC_API_KEY = "sk-ant-..."
